{
  "version": "cases-v1",
  "source": "REQUIREMENTS §9.1 (T1-T4, text word for word) and §9.2 (T5-T12, written as the employee would)",
  "cases": [
    {
      "id": "T1",
      "request_id": "REQ-0001",
      "text": "Hi, I'm Marcus (E1002). I'd like a second monitor for my desk, I'm juggling a lot of windows.",
      "expected_decision": "approve",
      "expected_code": "R-NEW",
      "required_tools": ["get_employee_info", "check_request_eligibility"]
    },
    {
      "id": "T2",
      "request_id": "REQ-0002",
      "text": "This is Priya, E1001. My laptop feels slow lately, can I get a new one?",
      "expected_decision": "deny",
